# Локальные переопределения для server (опционально).
# По умолчанию используется ../.env в корне монорепо — скопируйте ../.env.example → ../.env

# DATABASE_URL=postgresql://goshopix:goshopix@127.0.0.1:5432/goshopix?schema=public
# JWT_SECRET=change-me-dev-secret-min-32-chars

# --- Доставка: проверка города (СДЭК / Почта России) ---
# Без ключей используются встроенные справочники (ограниченный список ПВЗ СДЭК в коде).
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# DADATA_API_TOKEN=
