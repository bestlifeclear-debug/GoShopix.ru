# Скопируйте в .env в корне проекта для локальной разработки
# Подробнее: config/env/development.env.example

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://goshopixtest.vercel.app
API_PUBLIC_URL=https://goshopixtest.vercel.app
LOG_LEVEL=warn
JOBS_ENABLED=false

# Локально: город в шапке по IP (на 127.0.0.1 геолокация недоступна — подставится этот город)
# CITY_DETECT_DEV_CITY=Барнаул

# Client: VITE_API_URL пустой — API на том же домене (Vercel /api)

# Vercel (обязательно для Production + Redeploy после добавления):
# DATABASE_URL, DIRECT_URL, JWT_SECRET (≥16 символов), CORS_ORIGIN, API_PUBLIC_URL
# Проверка: GET /api/health/ready → checks.env и checks.database = ok
