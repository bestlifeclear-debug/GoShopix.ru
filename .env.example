# Скопируйте в .env в корне проекта для локальной разработки
# Подробнее: config/env/development.env.example

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://goshopix:goshopix@127.0.0.1:5432/goshopix?schema=public
JWT_SECRET=change-me-dev-secret-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:3000
LOG_LEVEL=debug
JOBS_ENABLED=true

