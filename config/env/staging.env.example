NODE_ENV=staging
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/goshopix_staging?schema=public
JWT_SECRET=replace-with-strong-staging-secret-32+
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://staging.goshopix.ru
API_PUBLIC_URL=https://staging.goshopix.ru
LOG_LEVEL=info
JOBS_ENABLED=true
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2
