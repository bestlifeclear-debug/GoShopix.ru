NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/goshopix?schema=public
JWT_SECRET=replace-with-strong-production-secret-32+
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://goshopix.ru
API_PUBLIC_URL=https://goshopix.ru
LOG_LEVEL=warn
JOBS_ENABLED=true
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
